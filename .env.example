# MongoDB connection (podman: podman run -d --name mongodb -p 27017:27017 -v mongodb-data:/data/db docker.io/library/mongo:8)
MONGODB_URI=mongodb://127.0.0.1:27017/quizforge

# Teacher login credentials (single teacher, from env)
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=change-me

# Secret used to sign the teacher's session cookie (generate: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Base URL of the app
APP_URL=http://localhost:3000
