# QuizForge app environment for Podman (rootful).
# Copy this file to /etc/quizforge/app.env and edit the values.
# This is a plain KEY=VALUE file — Quadlet does not shell-expand it.
MONGODB_URI=mongodb://quizforge-mongo:27017/quizforge
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
